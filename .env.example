# Microsoft Entra ID / Bot Framework Teams SSO
ENTRA_TENANT_ID=replace-with-tenant-id
ENTRA_APP_CLIENT_ID=replace-with-entra-client-id
BOT_FRAMEWORK_APP_ID=replace-with-bot-app-id
BOT_FRAMEWORK_APP_PASSWORD=replace-with-bot-client-secret
ENTRA_ISSUER=https://login.microsoftonline.com/<tenant-id>/v2.0
ENTRA_JWKS_URI=https://login.microsoftonline.com/<tenant-id>/discovery/v2.0/keys
JWT_ALLOWED_ALGS=RS256
JWT_CLOCK_SKEW_SECONDS=60

# Application
PULSE_APP_ENV=development
PULSE_LOG_LEVEL=INFO
PULSE_HOST=0.0.0.0
PULSE_PORT=3978

# PULSE maps its Teams adapter settings to the Bot Framework values above.
PULSE_TEAMS_CLIENT_ID=${BOT_FRAMEWORK_APP_ID}
PULSE_TEAMS_CLIENT_SECRET=${BOT_FRAMEWORK_APP_PASSWORD}
PULSE_TEAMS_TENANT_ID=${ENTRA_TENANT_ID}

# Never enable this for an ngrok endpoint or any shared environment.
# It is only intended for the local Microsoft 365 Agents Playground.
PULSE_TEAMS_SKIP_AUTH=false

# Groq
PULSE_GROQ_API_KEY=replace-with-groq-api-key
PULSE_GROQ_MODEL=llama-3.3-70b-versatile
PULSE_GROQ_TEMPERATURE=0.2
PULSE_GROQ_MAX_COMPLETION_TOKENS=1024
PULSE_GROQ_TIMEOUT_SECONDS=30

# Chat behavior
PULSE_MAX_USER_MESSAGE_CHARS=8000
PULSE_SYSTEM_PROMPT=You are PULSE, a concise and helpful internal assistant. Never claim that a timesheet operation succeeded unless the Orbit service confirms it.
